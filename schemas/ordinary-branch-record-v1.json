{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryankelleher5/chess-formula/schemas/ordinary-branch-record-v1.json",
  "title": "Context-aware ordinary legal branch record",
  "type": "object",
  "required": [
    "schema_version",
    "source_state_hash",
    "source_fen",
    "successor_fen",
    "move_uci",
    "side_to_move",
    "source_game",
    "partition",
    "root_candidate_uci",
    "node_role",
    "path_moves",
    "label_definition_version",
    "oracle"
  ],
  "properties": {
    "schema_version": {"const": "ordinary-branch-record-v1"},
    "source_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_fen": {"type": "string"},
    "successor_fen": {"type": "string"},
    "move_uci": {"type": "string"},
    "side_to_move": {"enum": ["white", "black"]},
    "source_game": {"type": "string"},
    "source_ply": {"type": "integer", "minimum": 0},
    "pair_group": {"type": "string"},
    "partition": {"const": "development"},
    "root_candidate_uci": {"type": "string"},
    "node_role": {"enum": ["root-candidate", "opponent-reply"]},
    "path_moves": {"type": "array", "items": {"type": "string"}},
    "move_rank": {"type": "integer", "minimum": 1},
    "regret_cp": {"type": "number", "minimum": 0},
    "top_k_labels": {"type": "object"},
    "regret_threshold_labels": {"type": "object"},
    "root_decision_consequence": {"type": ["object", "null"]},
    "refutation_necessity": {"type": ["object", "null"]},
    "value_of_information": {"type": ["number", "null"]},
    "label_definition_version": {"const": "ordinary-branch-foundation-v1"},
    "representation_version": {"type": ["string", "null"]},
    "oracle": {"type": "object"}
  },
  "additionalProperties": true
}
