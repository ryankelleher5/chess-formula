{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryankelleher5/chess-formula/schemas/branch-separable-oracle-record-v1.json",
  "title": "Independent constrained-root branch oracle record",
  "type": "object",
  "required": [
    "schema_version",
    "cache_key",
    "context_key",
    "context_kind",
    "fen",
    "side_to_move",
    "move_uci",
    "tier_id",
    "nodes_per_move",
    "eval_cp",
    "oracle_key",
    "partition"
  ],
  "properties": {
    "schema_version": {"const": "branch-separable-oracle-record-v1"},
    "cache_key": {"type": "string"},
    "context_key": {"type": "string"},
    "context_kind": {"enum": ["root", "parent"]},
    "source_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_candidate_uci": {"type": ["string", "null"]},
    "fen": {"type": "string"},
    "side_to_move": {"enum": ["white", "black"]},
    "legal_moves": {"type": "integer", "minimum": 1},
    "move_uci": {"type": "string"},
    "tier_id": {"type": "string"},
    "nodes_per_move": {"type": "integer", "minimum": 1},
    "requested_nodes": {"type": "integer", "minimum": 1},
    "reported_nodes": {"type": ["integer", "null"]},
    "eval_cp": {"type": "number"},
    "mate": {"type": ["integer", "null"]},
    "depth": {"type": ["integer", "null"]},
    "seldepth": {"type": ["integer", "null"]},
    "elapsed_ms": {"type": "number", "minimum": 0},
    "oracle_key": {"type": "string"},
    "partition": {"const": "development"}
  },
  "additionalProperties": false
}
